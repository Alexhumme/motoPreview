# Copia este archivo a `backend/.env` y completa los valores.
# OJO: `.env` NO se versiona en git (contiene secretos reales).

MOTOPREVIEW_DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=require

DJANGO_SECRET_KEY=
JWT_SECRET=
# Emisor de los JWT (debe ser el mismo al decodificar).
JWT_ISSUER=motopreview
JWT_LIFETIME_SECONDS=28800
# Límite de líneas por cotización (defensa contra payloads gigantes).
QUOTE_MAX_ITEMS=100
DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.replit.dev,.repl.co

# HTTPS (recomendado en Render):
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

FRONTEND_ORIGINS=http://localhost:5173

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
PASSWORD_RESET_URL=http://localhost:5173/recuperar-password
EMAIL_VERIFICATION_URL=http://localhost:5173/verificar